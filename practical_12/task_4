marks = [5, 4, 3, 5, 2, 5, 4, 3, 5, 5]

count_5 = 0 #счётчики
count_2 = 0

for mark in marks: #переменная mark по очереди принимает значения 5, 4, 3...
    if mark == 5:
        count_5 += 1 #увеличиваем счётчик пятёрок на 1
    elif mark == 2:
        count_2 += 1

print(f'Количество пятёрок: {count_5}')
print(f'Количество двоек: {count_2}')
