#задание 5

def run():
    hunter = Hunter('Герой', 100)

    hunter.add_weapon(SilverSword())
    hunter.add_weapon(CrossbowBolt())
    hunter.add_weapon(HolyWater())

    monsters = [Zombie('Кирилл'), Vampire('Михалыч'), Ghost('Валера'), Werewolf('Пёс')]

    for monster in monsters:
        print(f'Родился: {monster.get_name()}')

        while monster.is_alive() and hunter.is_alive():
            monster.show_status()
            print(f'Здоровье охотника: {hunter.get_hp()}')

            hunter.attack(monster)

            if monster.is_alive():
                monster.attack_hunter(hunter)
            if not hunter.is_alive():
                print('You died')

            print(f'{monster.get_name()} умер')
run()
