#задание 5

def run():
    hunter = Hunter('Герой', 100)

    hunter.add_weapon(SilverSword())
    hunter.add_weapon(CrossbowBolt())
    hunter.add_weapon(HolyWater())

    monsters = [Zombie('Кирилл'), Vampire('Михалыч'), Ghost('Валера'), Werewolf('Пёс')]

    for m in monsters:
        print(f'\nРодился: {m.get_name()} ★')

        while m.is_alive() and hunter.is_alive():
            m.show_status()
            print(f'\nЗдоровье охотника: {hunter.get_hp()} ❤')

            hunter.attack(m)

            if m.is_alive():
                m.attack_hunter(hunter)
            if not hunter.is_alive():
                print('\nYou died ☠')
                return

        print(f'\n{m.get_name()} умер 🕱')
run()
