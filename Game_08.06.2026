#задание 3

class Weapon:

    def __init__(self, name):
        self.name = name

class SilverSword(Weapon):
    def __init__(self):
        super().__init__('Серебряный меч')

    def use(self, monster):
        print(f'{self.name} атакует {monster.get_name()}')
        damage = 30
        if isinstance(monster, Werewolf):
            print('Серебро обжигает оборотня. Урон +10')
            monster.take_damage(30)

class HolyWater(Weapon):
        def __init__(self):
            super().__init__('Святая вода')

        def use(self, monster):
            print(f'{self.name} атакует {monster.get_name()}')
            monster.take_damage(30)

class CrossbowBolt(Weapon):
    def __init__(self):
        super().__init__('Арбалет')

    def use(self, monster):
        print(f'{self.name} атакует {monster.get_name()}')
        monster.take_damage(25)

