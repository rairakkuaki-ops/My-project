import random

#задание 1

class monster:
    def __init__(self, name, hp, dmg):
        self.__name = name
        self.__hp = hp
        self.__dmg = dmg

    def get_name(self):
        return self.__name
    def get_hp(self):
        return self.__hp
    def get_dmg(self):
        return self.__dmg

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value

    def is_alive(self):
        return self.__hp > 0

    def show_status(self):
        print(f'{self.__name} HP: {self.__hp}')

# m = monster('Вампир', 100, 10)
# m.show_status()
# m.set_hp(-0)
# m.show_status()
# print(m.is_alive())

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
    def attack_hunter(self, hunter):
        hunter.set_hp(hunter.get_hp() - self.get_dmg())
#задание 2

class Zombie(monster):
    def __init__(self, name):
        super().__init__(name, 120, 10)

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f'\n{self.get_name()} теряет конечность. Получен урон {damage} HP: {self.get_hp()} 🖔')

    def attack_hunter(self, hunter):
        hunter.set_hp(hunter.get_hp() - self.get_dmg())
        print(f'\n{self.get_name()} атакует охотника и наносит {self.get_dmg()} урона. ⚔')

class Vampire(monster):
    def __init__ (self, name):
        super().__init__(name, 80, 15)

    def take_damage(self, damage):

        damage -= 5
        if damage <= 0:
            damage = 0
        self.set_hp(self.get_hp() - damage)
        print(f'\n{self.get_name()} поглащает 5 урона. Получено {damage}. HP: {self.get_hp()} ❈')



class Ghost(monster):
    def __init__(self, name):
        super().__init__(name, 60, 20)

    def take_damage(self, damage):
        if random.random() < 0.3:
            print(f'\n{self.get_name()} уклонился от удара. Урон не получен. ⛕')
            return 0
        else:
            self.set_hp(self.get_hp() - damage)
            print((f'\n{self.get_name()} получает урон. Получен урон: {damage}. HP: {self.get_hp()} 🌢'))


class Werewolf(monster):
    def __init__(self, name):
        super().__init__(name, 100, 25)

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        if self.get_hp() < 50:
            print(f'\n{self.get_name()} трансформируется. Сила увеличивается. ✧')
            print(f'\n{self.get_name()} получает урон: {damage}. HP: {self.get_hp()} 🌢')


