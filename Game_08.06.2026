#задание 4

class Hunter:
    def __init__(self, name, hp = 100):
        self.__name = name
        self.__hp = hp
        self.__inventory = []

    def get_name(self):
        return self.__name
    def get_hp(self):
        return self.__hp

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value

    def add_weapon (self, weapon):
        self.__inventory.append(weapon)

    def show_inventory(self):
        print(self.__inventory)

    def attack(self, monster):
        for weapon in self.__inventory:
            if monster.is_alive():
                weapon.use(monster)

    def is_alive(self):
         if self.get_hp() > 0:
            return True
         else:
            return False

    def attack(self, monster):
        for weapon in self.__inventory:
            if monster.is_alive():
                weapon.use(monster)

