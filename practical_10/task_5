balance = 1000 #начальный баланс

print(f'\nКоманды в банкомате:\n1. Узнать баланс\n2. Снять 100 руб\n3. Положить 100 руб\n4. Выход')

while True: #начало бесконечного цикла
    num = int(input('\nВведите номер команды: '))

    if num == 1: #если пользователь выбрал первую команду
        print(f'Текущий баланс: {balance}')

    elif num == 2:
        if balance >= 100: #сравнение баланса, если баланс больше или равно 100
            balance -= 100 #минус 100 руб., с баланса
            print('Сянто!')
        else:
            print('Недостаточно средств') #сли недостаточно средств

    elif num == 3:
        balance += 100 #поплнение баланса на 100 руб.
        print('Баланс пополнен')

    elif num == 4:
        print('До свидания!')
        break #если пользователь вводит 4 команду, цикл принудительно завершается

    else:
        print('Неизвестная команда!')
