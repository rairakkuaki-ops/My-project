num = int(input('Введите число: '))

last_digit = num % 10 #выделяем последнию цифру

count_3 = 0
count_last = 0
count_even = 0
sum_greater_5 = 0
product_greater_7 = 1 #мы это будем умножать, поэтому 1(если умножать на ноль, то ничего не будет)
count_0_and_5 = 0

while num > 0:
    digit = num % 10  #берём последнюю цифру
    
    if digit == 3: #количество цифр 3
        count_3 += 1
    
    if digit == last_digit: #сколько раз встречается последняя цифра
        count_last += 1
    
    if digit % 2 == 0: #количество чётных
        count_even += 1
    
    if digit > 5: #количество цифр больше 5
        sum_greater_5 += digit
    
    if digit > 7: #те цифры, которые больше семи
        product_greater_7 *= digit
    
    if digit == 0 or digit == 5: #сколько раз встречается 0 и 5
        count_0_and_5 += 1
    
    num //= 10 #убираем последнию цифру

print(count_3)
print(count_last)
print(count_even)
print(sum_greater_5)
print(product_greater_7)
print(count_0_and_5)
