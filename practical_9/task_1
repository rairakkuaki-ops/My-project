num = int(input('Введите натуральное число: '))
n = 1 #с чего начинается наш цикл(счётчик)

while n <= num:
    if 5 <= n <= 9:
        n += 1 #делвем шаг вперёд число уыеличивается на один
        continue #если заданный диапазон True, то код пропускает его 
    elif 17 <= n <= 37:
        n += 1
        continue
    elif 78 <= n <= 87:
        n += 1
        continue

    print(n)
    n += 1
