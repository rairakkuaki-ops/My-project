print('\nГипотеза Эйлера о сумме степеней\n')

found = False
for a in range(1, 151):
    for b in range(a, 151):
        for c in range(b, 151):
            for d in range(c, 151):
                left = a**5 + b**5 + c**5 + d**5

                e = int(round(left ** (1/5)))
                if e**5 == left and e <= 150:
                    print(f'Найдено:' {a} {b} {c} {d} {e}')
                    print('Сумма:', a+b+c+d+e)
                    found = True
                    break
            if found:
                break
        if found:
            break
    if found:
        break
